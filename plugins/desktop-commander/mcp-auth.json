{
  "version": 1,
  "servers": {
    "desktopCommander": {
      "mode": "oauth",
      "oauth": {
        "credentialStorage": "host-managed"
      },
      "deviceAgent": {
        "required": true,
        "pairing": "oauth-device-flow",
        "localSessionFile": "~/.desktop-commander-device/device.json"
      }
    }
  }
}
