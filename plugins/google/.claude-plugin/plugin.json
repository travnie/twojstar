  "license": "Apache-2.0",
  "keywords": [
    "android",
    "kotlin",
    "jetpack-compose",
    "gradle",
    "chrome-extensions",
    "manifest-v3",
    "web-platform",
    "baseline",
    "mcp",
    "google-cloud",
    "gcloud",
    "cloud-storage",
    "compute-engine"
  ],
  "icon": "./assets/icon.png",
  "documentationUrl": "https://github.com/travnie/twojstar/tree/main/plugins/google",
  "supportUrl": "https://github.com/travnie/twojstar/blob/main/docs/plugins/SUPPORT.md",
  "privacyPolicyUrl": "https://github.com/travnie/twojstar/blob/main/docs/plugins/PRIVACY.md",
  "termsOfServiceUrl": "https://github.com/travnie/twojstar/blob/main/docs/plugins/TERMS.md",
  "mcpServers": {
    "google-developer": {
