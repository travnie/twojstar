    },
    "google-cloud-storage": {
      "type": "http",
      "url": "https://storage.googleapis.com/storage/mcp"
    },
    "google-compute": {
      "type": "http",
      "url": "https://compute.googleapis.com/mcp"
    },
    "google-monitoring": {
      "type": "http",
      "url": "https://monitoring.googleapis.com/mcp"
    }
