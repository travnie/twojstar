# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local IDE/editor state
.vs/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Local environment files
.env
.env.local
.env.*.local

# Logs and common tool caches
*.log
**/.cache/
**/.mypy_cache/
**/.pytest_cache/
**/.ruff_cache/
**/*.egg-info/
**/__pycache__/

# JavaScript package managers
**/node_modules/
**/.npm/
**/.pnpm-store/
**/.yarn/cache/
**/coverage/

# .NET outputs
**/bin/
**/obj/

# CMake / native build outputs
**/CMakeFiles/
**/CMakeCache.txt
**/cmake_install.cmake
**/compile_commands.json
**/build/
**/build-*/
*.vst3

# Java / Gradle outputs
**/.gradle/
*.class
*.jar
*.war
*.nar
*.ear

# Generated archives
*.zip
*.tar.gz
*.rar
*.7z

# Paint.NET generated/downloaded files
/addons/paintdotnet/**/dist/
/addons/paintdotnet/ai/model/

# JVM crash logs
hs_err_pid*
replay_pid*

# Claude Code: cloud hooks/settings live in the environment setup script; local .claude/ is per-machine
.claude/

# SpaceMolt CLI session token (written to cwd by the official client)
.spacemolt-session.json

# Local tooling / agent state
CLAUDE.local.md
.wrangler/
worker-configuration.d.ts
*.tsbuildinfo
.kotlin/
.venv/
local.properties
.dev.vars

# Benches: bundled frontend assets, while keeping checked-in runtime JS
/benches/codebench/public/vendor/
/benches/codebench/public/fonts/
/benches/codebench/public/portable.html
/benches/codebench/public/*.js
!/benches/codebench/public/i18n.js
!/benches/codebench/public/i18n-runtime.js
!/benches/codebench/public/webmcp-lifecycle.js

/benches/docbench/public/vendor/
/benches/docbench/public/fonts/
/benches/docbench/public/portable.html

/benches/streambench/public/vendor/
/benches/streambench/public/portable.html
/benches/streambench/public/*.js
!/benches/streambench/public/i18n.js
!/benches/streambench/public/i18n-runtime.js
!/benches/streambench/public/webmcp-lifecycle.js

# Feedboard packaging and signing
/feedboard/src/**/AppPackages/
/feedboard/artifacts/
/feedboard/**/*.pfx

# Weather feed output
/weather-feed/**/dist/

# Legacy Xiaomi tooling; retain the executable Gradle wrapper
/xiaomi-adb-tools/**/*.ctxt
/xiaomi-adb-tools/**/.mtj.tmp/
!/xiaomi-adb-tools/gradle/wrapper/gradle-wrapper.jar
