{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spacemolt-gateway",
  "main": "worker.js",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "STATE",
      "id": "e48ac4b3bc984700b61d804c887a1bc6"
    }
  ],
  "services": [
    {
      "binding": "KANAREK_PLANNER",
      "service": "kanarek-review",
      "entrypoint": "SpaceMoltPlannerEntrypoint"
    }
  ],
  "vars": {
    "SPACEMOLT_PLAYER_ID": "927ac82a2eac80eb3f3efe917c93b407",
    "WORKERS_AI_DAILY_NEURONS": "10000",
    "WORKERS_AI_MAX_OUTPUT_TOKENS": "16384"
  },
  "triggers": {
    "crons": ["37 19,20 * * *"]
  }
}
